# Для запуска приложения вне Docker Compose
DATABASE_URL=postgresql+psycopg://kadry:kadry@localhost:5433/kadry
SHOW_DOCS=true

# Адрес системы для ссылок в письмах.
# Тестовый контур (машина разработчика): http://<IP машины>:8000
# Сервер БНТУ (согласовано): http://kadry-zakaz.bntu.by
APP_URL=http://localhost:8000

# SMTP служебного ящика БНТУ; реквизиты выдаёт ИТ-отдел при развёртывании
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
